<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Wedding</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 800px;
            margin: 50px auto;
            padding: 20px;
            text-align: center;
            background-color: #f5f5f5;
        }
        h1 { color: #333; }
        button { padding: 10px 20px; margin: 10px; cursor: pointer; }
        .form { background: white; padding: 20px; border-radius: 8px; }
    </style>
</head>
<body>
    <h1 id="title">Our Wedding</h1>
    <button onclick="switchLanguage()">🌐 Switch to Spanish</button>
    
    <div class="form">
        <p id="text">Will you join us?</p>
        <input type="text" id="name" placeholder="Your name">
        <button onclick="rsvp()">RSVP</button>
    </div>

    <script>
        let lang = 'en';
        function switchLanguage() {
            lang = lang === 'en' ? 'es' : 'en';
            document.getElementById('title').textContent = lang === 'en' ? 'Our Wedding' : 'Nuestra Boda';
            document.getElementById('text').textContent = lang === 'en' ? 'Will you join us?' : '¿Te unirás a nosotros?';
        }
        function rsvp() {
            alert('Thank you for RSVPing!');
        }
    </script>
</body>
</html>
